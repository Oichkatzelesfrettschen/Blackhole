diff --git a/modules/src/data/warnings.h b/modules/src/data/warnings.h
index f320b9f..6ecaf56 100644
--- a/modules/src/data/warnings.h
+++ b/modules/src/data/warnings.h
@@ -1,6 +1,16 @@
 #ifndef DIAGNOSTICS_H
 #define DIAGNOSTICS_H
 
+/* NORETURN: function-attribute marker for functions that never return.
+ * Modern GCC/clang have __attribute__; older toolchains get an empty stub. */
+#ifndef NORETURN
+#if defined(__GNUC__) || defined(__clang__)
+#define NORETURN __attribute__((noreturn))
+#else
+#define NORETURN
+#endif
+#endif
+
 extern const char* program_name;
 
