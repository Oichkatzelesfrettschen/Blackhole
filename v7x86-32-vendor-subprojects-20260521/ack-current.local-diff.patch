diff --git a/util/LLgen/src/Lpars.h b/util/LLgen/src/Lpars.h
index d7ee159..016e2e1 100644
--- a/util/LLgen/src/Lpars.h
+++ b/util/LLgen/src/Lpars.h
@@ -1,4 +1,15 @@
 /* LLgen generated code from source . */
+
+/* UNREACHABLE_CODE: marker for code paths the compiler must trust are dead.
+ * Modern GCC/clang have a builtin; older toolchains get an empty stmt. */
+#ifndef UNREACHABLE_CODE
+#if defined(__GNUC__) || defined(__clang__)
+#define UNREACHABLE_CODE __builtin_unreachable()
+#else
+#define UNREACHABLE_CODE do { } while (0)
+#endif
+#endif
+
